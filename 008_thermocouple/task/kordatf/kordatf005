restart = 0;
title = 'VD.035.004 lab8_harm_0.03';

! ------------------------------------------------------------
! Вспомогательные константы
! ------------------------------------------------------------
pi = acos(-1.);
d = 0.005;
r = d/2.;              

! --- Параметры гармонического сигнала (200 °C) ---
t0     = 473.15;       ! Начальная температура (200 °C)
t_mean = 473.15;       ! Средняя температура среды (200 °C)
a_in   = 5.;           ! Амплитуда колебаний (5 К)
freq   = 0.03;         ! <--- ТЕКУЩАЯ ЧАСТОТА (0.03 Гц)

alpha = 1000.;         
kgrid = 21;            

! ------------------------------------------------------------
! Настройки времени
! ------------------------------------------------------------
! Время расчета: 30 секунд на прогрев + 4 полных периода колебаний (4/0.03 ? 133.3 с)
! Итого: 30 + 133.3 = 163.3 секунд.
fin_tim = 30. + 4./freq; 

! Шаг вывода: 40 точек на один период (период 33.33 с / 40 ? 0.833 с)
dt_out = (1./freq) / 40.;  

dt_max = 2.e-4;        

! ------------------------------------------------------------
! Схема
! ------------------------------------------------------------
layout
  hcs1(1)/1 - bheat1;
  hcs1(1)/2 - bheat2;
end

call hcs1;
call bheat1;
call bheat2;

set vozm;    
out temp;    

end

! ------------------------------------------------------------
! Теплопроводящая конструкция
! ------------------------------------------------------------
data hcs1
  n  = 1;        
  kl = 1;        
  k  = kgrid;    
  nl = 1;        
  nc = 1;        
  type = 0;      
  coor = 1;      
  xl(1) = 0.;
  xl(2) = r;
  x(1:kgrid) = lina(0., r, kgrid);
  
  tl = t0;             
  lam = 30.;           
  tc = t0;             
  cr = 3.9e6;          

  dfz = 1.;            
  b   = 1.;            
  qx = 0.;             
end

data bheat1
  type = 2;            
  bcond = 0., 0.;
end

data bheat2
  type = 3;            
  bcond = alpha, t0;   
end

event vozm
  bcond.bheat2(2) = t_mean + a_in * sin(2. * pi * freq * tau);
end

output temp
  write tenv.hcs1(2,1), 
        t.hcs1(1,1);
end