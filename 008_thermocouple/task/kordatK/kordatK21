restart = 0;
title = 'VD.035.004 lab8v1';

! ------------------------------------------------------------
! Вспомогательные геометрические и физические константы
! ------------------------------------------------------------
pi = acos(-1.);
d = 0.005;
r = d/2.;              ! r = 0.0025 м

t0 = 293.15;           ! начальная температура, К
tb = 473.15;           ! температура среды после скачка, К
alpha = 1000.;         ! коэффициент теплоотдачи, Вт/(м2*К)

kgrid = 21;            ! число узлов по радиусу

! Оценка шага по времени: dt_max <= 0.1*dr^2/a ~ 2e-4 с
dt_max = 2.e-4;
dt_out = 0.01;
fin_tim = 60.;

! ------------------------------------------------------------
! Объявление переменных для EVENT (безразмерные параметры и потоки)
! ------------------------------------------------------------
bi = 0.0833333;        ! Число Био: Bi = alpha*r/lam = 1000*0.0025/30
a  = 7.692308e-6;      ! Температуропроводность: a = lam/cr = 30 / 3.9e6
fo = 0.;               ! Число Фурье (рассчитывается на каждом шаге)
theta_c = 0.;          ! Безразмерная температура на оси
theta_s = 0.;          ! Безразмерная температура на поверхности
q_flux = 0.;           ! Плотность теплового потока, Вт/м2
q_pow = 0.;            ! Полная мощность, Вт

! ------------------------------------------------------------
! Нодализационная схема
! ------------------------------------------------------------
layout
  hcs1(1)/1 - bheat1;
  hcs1(1)/2 - bheat2;
end

call hcs1;
call bheat1;
call bheat2;

set vozm;    ! Скачок температуры
set calc;    ! Расчет формул на каждом шаге
out temp;    ! Вывод в KORRES

end

data hcs1
  n  = 1;        
  kl = 1;        
  k  = kgrid;    
  nl = 1;        
  nc = 1;        
  type = 0;      
  coor = 1;      
  xl(1) = 0.;
  xl(2) = r;
  x(1:kgrid) = lina(0., r, kgrid);
  
  tl = t0;
  lam = 30.;           ! Теплопроводность, Вт/(м*К)
  
  tc = t0;
  cr = 3.9e6;          ! Объемная теплоемкость (rho*cp), Дж/(м3*К)

  dfz = 1.;            ! Длина цилиндра, м
  b   = 1.;            ! Количество стержней
  qx = 0.;             ! Внутренние источники тепла
end

! ------------------------------------------------------------
! Граничные условия
! ------------------------------------------------------------
data bheat1
  type = 2;            ! ГУ 2 рода (адиабата на оси)
  bcond = 0., 0.;
end

data bheat2
  type = 3;            ! ГУ 3 рода (теплообмен со средой)
  bcond = alpha, t0;
end

! ------------------------------------------------------------
! Скачок температуры среды (один раз в начале)
! ------------------------------------------------------------
event vozm
  type = 6;
  bcond.bheat2(2) = tb;
end

! ------------------------------------------------------------
! Расчет размерных и безразмерных параметров на каждом шаге
! ------------------------------------------------------------
event calc
  ! Число Фурье: Fo = a * tau / r^2
  fo = a * TAU / (r**2);
  
  ! Безразмерная температура: theta = (T - T_среды) / (T_начальная - T_среды)
  theta_c = (T.HCS1(1,1) - tb) / (t0 - tb);
  theta_s = (TW.HCS1(2,1) - tb) / (t0 - tb);
  
  ! Размерные потоки
  q_flux = ALW.HCS1(2,1) * (TENV.HCS1(2,1) - TW.HCS1(2,1));
  q_pow  = q_flux * DF.HCS1(2,1);
end

! ------------------------------------------------------------
! Вывод в KORRES 
! ------------------------------------------------------------
output temp
  write t.hcs1(1:kgrid,1),
        tw.hcs1(2,1),
        fo, bi, theta_c, theta_s, q_flux, q_pow;
end