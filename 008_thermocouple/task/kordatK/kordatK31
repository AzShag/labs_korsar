restart = 0;
title = 'VD.035.004 lab8_K31';

! ------------------------------------------------------------
! Вспомогательные геометрические и физические константы
! ------------------------------------------------------------
pi = acos(-1.);
d = 0.005;
r = d/2.;              ! r = 0.0025 м

t0 = 293.15;           ! начальная температура, К
tb = 473.15;           ! температура среды после скачка, К
alpha = 1000.;         ! коэффициент теплоотдачи, Вт/(м2*К)

kgrid = 31;            ! <--- ИЗМЕНЕНО: число узлов по радиусу

! Оценка шага по времени для K=31: dt_max <= 0.1*dr^2/a ~ 9e-5 с
dt_max = 5.e-5;        ! <--- ИЗМЕНЕНО: шаг значительно уменьшен
dt_out = 0.01;
fin_tim = 60.;

! ------------------------------------------------------------
! Объявление переменных для EVENT
! ------------------------------------------------------------
bi = 0.0833333;        
a  = 7.692308e-6;      
fo = 0.;               
theta_c = 0.;          
theta_s = 0.;          
q_flux = 0.;           
q_pow = 0.;            

! ------------------------------------------------------------
! Нодализационная схема
! ------------------------------------------------------------
layout
  hcs1(1)/1 - bheat1;
  hcs1(1)/2 - bheat2;
end

call hcs1;
call bheat1;
call bheat2;

set vozm;    
set calc;    
out temp;    

end

! ------------------------------------------------------------
! Теплопроводящая конструкция
! ------------------------------------------------------------
data hcs1
  n  = 1;        
  kl = 1;        
  k  = kgrid;    ! <--- ИЗМЕНЕНО: K=31
  nl = 1;        
  nc = 1;        
  type = 0;      
  coor = 1;      
  xl(1) = 0.;
  xl(2) = r;
  x(1:kgrid) = lina(0., r, kgrid); 
  
  tl = t0;
  lam = 30.;           
  tc = t0;
  cr = 3.9e6;          

  dfz = 1.;            
  b   = 1.;            
  qx = 0.;             
end

data bheat1
  type = 2;            
  bcond = 0., 0.;
end

data bheat2
  type = 3;            
  bcond = alpha, t0;
end

event vozm
  type = 6;
  bcond.bheat2(2) = tb;
end

event calc
  fo = a * TAU / (r**2);
  theta_c = (T.HCS1(1,1) - tb) / (t0 - tb);
  theta_s = (TW.HCS1(2,1) - tb) / (t0 - tb);
  q_flux = ALW.HCS1(2,1) * (TENV.HCS1(2,1) - TW.HCS1(2,1));
  q_pow  = q_flux * DF.HCS1(2,1);
end

! ------------------------------------------------------------
! ВЫВОД В KORRES
! ------------------------------------------------------------
output temp
  write t.hcs1(1:kgrid,1),
        tw.hcs1(2,1),
        fo, bi, theta_c, theta_s, q_flux, q_pow;
end